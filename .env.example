# ============================================================
# Copy this file to .env :   cp .env.example .env
# Then fill in the values. NEVER commit the .env file!
# ============================================================

# Private key of the deploying wallet (export it from MetaMask:
# Account details > Export private key). It needs testnet USDC to pay
# gas — on Arc, gas is paid in USDC, the network's native currency,
# not ETH.
PRIVATE_KEY=

# Arc Testnet RPC (verified chain ID: 5042002)
ARC_RPC_URL=https://rpc.testnet.arc.network

# Optional but recommended: a dedicated Alchemy RPC, used ahead of
# ARC_RPC_URL above if set. The public RPC has a strict rate limit
# (~1 req/s, "request limit reached" errors).
# Create a free key: https://www.alchemy.com/rpc/arc-testnet
# -> Create new app -> chain "Arc" -> network "Testnet" -> copy the URL
# (format https://arc-testnet.g.alchemy.com/v2/<api-key>)
ARC_RPC_URL_ALCHEMY=

# Circle's official USDC address on Arc Testnet.
# Verify at https://developers.circle.com/stablecoins/usdc-contract-addresses
# Leave empty and the deploy script will deploy a MockUSDC for you instead.
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Optional: address that receives protocol fees. Defaults to the
# deployer's own address if left empty.
TREASURY_ADDRESS=
