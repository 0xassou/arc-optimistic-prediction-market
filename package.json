{
  "name": "arc-optimistic-prediction-market",
  "version": "1.0.0",
  "private": false,
  "license": "MIT",
  "description": "A parimutuel prediction market with optimistic-oracle resolution (propose -> dispute -> finalize/arbitrate) — a free, forkable alternative to a paid oracle, built for Arc.",
  "keywords": [
    "arc",
    "solidity",
    "smart-contract",
    "prediction-market",
    "optimistic-oracle",
    "hardhat"
  ],
  "scripts": {
